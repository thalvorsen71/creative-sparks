# Password for the whole site. Required in production and on preview
# deployments: without it nobody can sign in (the gate fails closed).
SITE_PASSWORD=

# Optional. Canonical origin used in share links for public prototypes,
# e.g. https://sparks.example.com. Falls back to the Vercel URL.
NEXT_PUBLIC_SITE_URL=

# Only needed once a prototype calls a model. Server-side only.
ANTHROPIC_API_KEY=
